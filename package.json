{
  "name": "@salmanulfaris/sql-mcp",
  "version": "0.3.0",
  "description": "MCP server that gives AI agents accurate MySQL schema and data access — no more schema guessing",
  "type": "module",
  "bin": {
    "sql-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "release": "node scripts/publish.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.5.0",
    "mysql2": "^3.11.0",
    "pg": "^8.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "libnpmpublish": "^11.2.0",
    "pacote": "^21.5.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "mysql",
    "sql",
    "ai",
    "agent",
    "database",
    "schema"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salmanulfaris/sql-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/salmanulfaris/sql-mcp/issues"
  },
  "homepage": "https://github.com/salmanulfaris/sql-mcp#readme"
}
